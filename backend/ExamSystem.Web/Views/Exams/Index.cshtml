@model ActiveExamsResponse
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Exams.Title"];
    var isEn = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en";
}

<h1>@Localizer["Exams.Title"]</h1>
<p class="student-info">
    <strong>@Model.Student.FullName</strong>
    <span class="muted">@Localizer["Exams.JmbagLabel"]: @Model.Student.Jmbag</span>
</p>

@if (Model.Exams.Count == 0)
{
    <p class="empty-state">@Localizer["Exams.NoExams"]</p>
}
else
{
    <div class="exam-list">
        @foreach (var exam in Model.Exams)
        {
            <div class="card exam-card">
                <h2>@(isEn ? exam.CourseNameEN : exam.CourseNameHR)</h2>
                <p>@Localizer["Shared.ExamDateTimeLabel"]: @exam.ExamDateTime.ToString("dd.MM.yyyy. HH:mm")</p>
                <p>@Localizer["Shared.ClassroomLabel"]: @exam.Classroom</p>
                <form method="post" action="/exams/@exam.ExamId/select">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-primary">@Localizer["Exams.SelectButton"]</button>
                </form>
            </div>
        }
    </div>
}
