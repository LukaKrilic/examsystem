<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Sustav za provođenje ispita</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentLang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
        var returnUrl = Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString);
    }
    <header class="site-header">
        <div class="site-header-inner">
            <a class="brand" href="/">Sustav za provođenje ispita</a>
            <nav class="lang-switch" aria-label="Language">
                <a class="lang-link @(currentLang == "hr" ? "active" : "")" href="/set-language?lang=hr&amp;returnUrl=@returnUrl">HR</a>
                <a class="lang-link @(currentLang == "en" ? "active" : "")" href="/set-language?lang=en&amp;returnUrl=@returnUrl">EN</a>
            </nav>
        </div>
    </header>
    <main class="page">
        @RenderBody()
    </main>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
